# =============================================================================
# Copy file này thành .env rồi điền key thật:  cp .env.example .env
# Cần TỐI THIỂU một trong ba key sinh câu trả lời (Gemini / OpenRouter / OpenAI).
# =============================================================================

# Gemini API Key — ĐƯỜNG CHÍNH của bài lab.
# Task 10 ưu tiên provider này, và group_project/evaluation/eval_pipeline.py
# BẮT BUỘC phải có key này (dùng làm LLM judge cho RAGAS).
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter API Key — fallback sinh câu trả lời, đồng thời là key dùng cho
# HyDE (Task 5) và Query Expansion (src/supervisor.py).
# Có nhiều model hậu tố ":free": https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=

# OpenAI API Key (tuỳ chọn) — fallback cuối nếu hai key trên đều hết quota.
# OPENAI_API_KEY=sk-proj-...

# PageIndex API Key (tuỳ chọn) — Task 8: vectorless RAG fallback.
# Không có key thì pipeline vẫn chạy, chỉ là nhánh fallback trả về rỗng.
# Đăng ký tại: https://pageindex.ai/
# PAGEINDEX_API_KEY=pix_...

# Jina API Key (tuỳ chọn) — Task 7: cross-encoder reranking.
# Không có key thì rerank tự động chuyển sang RRF.
# JINA_API_KEY=jina_...
